# Raw Excel exports are intentionally kept out of Git.
data/*.xlsx
data/raw/**/*.xlsx
data/raw/**/*.parquet
data/clean/**/*.json
data/clean/.gitkeep
data/clean/README.md
data/clean/CURRENT
data/clean/CURRENT.example
__pycache__/
*.pyc
logs/
reports/
.streamlit/secrets.toml

# Python tooling artifacts
.pytest_cache/
*.egg-info/
.coverage
.coverage.*

# Frontend tooling artifacts
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
frontend/test-results/
frontend/playwright-report/
frontend/vite.config.js
frontend/vite.config.d.ts

# R session files
.RData
.Rhistory

# Local Claude Code settings
.claude/

# Production secrets (never commit) — keep .env.example as the template.
# .env.production is committed: it only contains public build-time config
# for Vite (no secrets — Vite inlines anything VITE_* in the bundle anyway).
.env
.env.*
!.env.example
!frontend/.env.production

# Keep only versioned clean snapshots in Git.
data/*.parquet
data/raw/**

data/clean/
data/slim/
data/cache/
