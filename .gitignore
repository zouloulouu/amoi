data/clean/**/*.json
data/clean/.gitkeep
data/clean/README.md
data/clean/CURRENT
data/clean/CURRENT.example
__pycache__/
*.pyc
logs/

# Keep only versioned clean snapshots in Git.
data/*.parquet
data/raw/**
