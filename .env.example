# Copy to .env (gitignored) and fill in real values before `docker compose up`.

# HuggingFace dataset access (optional).
# Required only if data/clean/CURRENT is empty AND the HF dataset is private,
# or if you want the dictionaries.json mirror to push back to HF.
HF_TOKEN=

# Comma-separated allowed origins for CORS in local/dev deployments.
# On the single-VPS nginx setup, frontend and API share the same origin, so this
# can usually stay empty or be omitted.
# Examples:
#   Local dev:        http://localhost:5173,http://127.0.0.1:5173
#   Production:       https://tondomaine.fr
INA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# HF dataset repo id used by the data store + dictionaries mirror.
INA_HF_REPO_ID=zouloulouu/data_ina_clean

# FastAPI cache tuning.
# 4 is conservative for the OVH VPS-1 / 8 GB RAM setup with a 3.5 GB container cap.
INA_TAGGING_CACHE_MAXSIZE=4

# Set to 1 if the backend ever shows memory pressure during startup.
INA_DISABLE_PREWARM=0
